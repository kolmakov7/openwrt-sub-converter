#!/bin/sh /etc/rc.common
# procd init script for the OpenWRT Sub Converter daemon.

USE_PROCD=1

START=95
STOP=01

PROG=/usr/sbin/subconvd

start_service() {
	local enabled listen port

	config_load sub-converter
	config_get_bool enabled service main enabled 1
	[ "$enabled" = "1" ] || return 0

	config_get listen service main listen 0.0.0.0
	config_get port service main port 9099

	procd_open_instance
	procd_set_param command "$PROG"
	procd_append_param command --host "$listen"
	procd_append_param command --port "$port"
	procd_set_param respawn
	procd_set_param file /etc/config/sub-converter
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
